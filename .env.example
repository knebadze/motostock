# Read by docker-compose.yml itself (not by the backend or frontend app
# code) — copy to ".env" at the repo root and fill in real values.
# backend/.env.example and frontend/.env.local.example are separate and
# still needed (see DEPLOY.md).

POSTGRES_USER=motostock
POSTGRES_PASSWORD=changeme
POSTGRES_DB=motostock

# Baked into the frontend's client bundle at build time (see
# frontend/Dockerfile) — must be real, reachable URLs.
#
# Test phase (no domain yet, accessed by VPS IP) — one origin, path-routed
# by Caddyfile's :80 block. Replace <VPS_IP> below with the real IP:
NEXT_PUBLIC_API_URL=http://<VPS_IP>/api
NEXT_PUBLIC_SITE_URL=http://<VPS_IP>
#
# Later, once motostock22.ge is pointed at the VPS (see "რეალურ დომენზე
# გადასვლა" in DEPLOY.md), switch both to:
# NEXT_PUBLIC_API_URL=https://motostock22.ge/api
# NEXT_PUBLIC_SITE_URL=https://motostock22.ge

# Caddy (see Caddyfile). Leave both unset in the test phase. Production:
# SITE_ADDRESS=motostock22.ge turns on automatic HTTPS; HSTS_MAX_AGE then
# goes 300 → 604800 → 31536000 over a couple of weeks (DEPLOY.md).
# SITE_ADDRESS=motostock22.ge
# HSTS_MAX_AGE=300

# Optional — leave commented out until a Google Analytics 4 property exists
# for this site. Once you have a Measurement ID (looks like "G-XXXXXXXXXX"),
# uncomment it and rebuild (docker compose build frontend && docker compose
# up -d) — analytics turns on with no other code changes needed.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional — Sentry error monitoring for the FRONTEND (browser + SSR). Leave
# empty until a Sentry project exists. After filling these in, rebuild the
# frontend (docker compose build frontend && docker compose up -d) and then
# switch it on in admin → პარამეტრები → მონიტორინგი. The backend's own key
# (SENTRY_DSN) goes in backend/.env, not here.
#   NEXT_PUBLIC_SENTRY_DSN  — sentry.io → frontend project → Settings → Client Keys (DSN)
#   SENTRY_AUTH_TOKEN/ORG/PROJECT — optional, only for readable stack traces
#     (source maps); token from sentry.io → Settings → Auth Tokens.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
