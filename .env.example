# Read by docker-compose.yml itself (not by the backend or frontend app
# code) — copy to ".env" at the repo root and fill in real values.
# backend/.env.example and frontend/.env.local.example are separate and
# still needed (see DEPLOY.md).

POSTGRES_USER=motostock
POSTGRES_PASSWORD=changeme
POSTGRES_DB=motostock

# Baked into the frontend's client bundle at build time (see
# frontend/Dockerfile) — must be real, reachable URLs.
#
# Test phase (no domain yet, accessed by VPS IP) — one origin, path-routed
# by Caddyfile's :80 block. Replace <VPS_IP> below with the real IP:
NEXT_PUBLIC_API_URL=http://<VPS_IP>/api
NEXT_PUBLIC_SITE_URL=http://<VPS_IP>
#
# Later, once a real domain is pointed at the VPS (see "რეალურ დომენზე
# გადასვლა" in DEPLOY.md), switch both to:
# NEXT_PUBLIC_API_URL=https://example.com/api
# NEXT_PUBLIC_SITE_URL=https://example.com
