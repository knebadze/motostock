DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/motostock"
JWT_SECRET=changeme
# Session lifetime is no longer configurable via env — fixed at a 2h sliding
# idle timeout (reissued on every authenticated request) with a 30-day
# absolute cap, see backend/src/lib/jwt.ts.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins allowed to call the API (CORS), on top of
# FRONTEND_ORIGIN — e.g. the `www` subdomain if Caddy serves both it and the
# apex domain (see DEPLOY.md's real-domain cutover). Leave empty if the
# frontend is only ever reachable at exactly FRONTEND_ORIGIN.
# FRONTEND_ORIGIN_ALTERNATES=https://www.example.com
FRONTEND_ORIGIN_ALTERNATES=
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FINA_BASE_URL=
FINA_LOGIN=
FINA_PASSWORD=
FINA_TENANT_KEY=
FINA_STORE=
FINA_SYNC_INTERVAL_MINUTES=15
BACKEND_PUBLIC_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Any SMTP provider works here (Gmail, AWS SES, Mailgun, SendGrid SMTP
# relay, your own mail server) — password-reset emails are dormant with a
# clean error until these are filled in.
# For Gmail specifically: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER/SMTP_FROM=your Gmail address, and
# SMTP_PASSWORD must be a Google "App Password" (not your regular Gmail
# password) — requires 2-factor auth enabled, generate one at
# myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
