// A user's delivery address — one-to-one for now (@@unique([userId])), since
// the site only needs a single "primary address" today. Modeled as its own
// table (rather than columns on User) so a future move to multiple saved
// addresses per user only requires dropping that unique constraint, not a
// data migration.
model Address {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  cityId     Int
  city       City     @relation(fields: [cityId], references: [id])
  street     String
  building   String?
  apartment  String?
  postalCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cityId])
  @@schema("dbo")
}
