// A user's delivery address — a user may save more than one (e.g. home +
// office), so this is a plain owned-child table under User (onDelete:
// Cascade), same shape as GarageVehicle.
model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String
  cityId     Int
  city       City     @relation(fields: [cityId], references: [id])
  street     String
  building   String?
  apartment  String?
  postalCode String?
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([cityId])
  @@schema("dbo")
}
