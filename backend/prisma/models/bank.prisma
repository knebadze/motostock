// Admin-configurable list of banks a customer can pay through when
// checking out with fulfillmentMethod=CARD. No real payment gateway is
// integrated yet (see order.prisma's note) — this exists so the admin can
// set up the bank list ahead of that integration, and so the checkout UI
// has something real to let the customer choose between right now.
//
// Deliberately holds no credentials (merchant id, API key/secret, ...) —
// an earlier version of this model had a free-form `credentials Json?`
// column for that, removed because storing real payment-gateway secrets
// in the DB (even admin-only, even masked on read) is the wrong shape for
// them. When a real gateway integration is built, its credentials belong
// in environment variables (see config/env.ts — same pattern already used
// for FINA_*/SMTP_*/VINCARIO_* credentials), not here.
model Bank {
  id        Int     @id @default(autoincrement())
  // Stable identifier (e.g. "TBC", "BOG", "LIBERTY") — independent of the
  // display name, which is localized and admin-editable.
  key       String  @unique
  nameKa    String
  nameEn    String
  nameRu    String
  logoUrl   String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  // Purely informational for now — no installment/split-payment logic
  // exists yet. Lets the checkout later filter which banks to offer for
  // which payment type once that logic is built, without a schema change.
  supportsInstallment  Boolean @default(false)
  supportsSplitPayment Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("dbo")
}
