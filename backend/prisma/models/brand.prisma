model Brand {
  id        Int              @id @default(autoincrement())
  nameKa    String
  nameEn    String
  nameRu    String
  slug      String           @unique
  logoUrl   String?
  models    Model[]
  vehicles  VehicleCatalog[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@schema("cla")
}
