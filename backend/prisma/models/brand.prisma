model Brand {
  id         Int              @id @default(autoincrement())
  name       String
  slug       String           @unique
  logoUrl    String?
  models     Model[]
  vehicles   VehicleCatalog[]
  promoCodes PromoCode[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@schema("cla")
}
