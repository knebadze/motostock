enum BulkDiscountEventTargetType {
  PRODUCT
  VEHICLE_LISTING

  @@schema("dbo")
}

// Optional grouping for a batch of discounts applied together via the admin
// bulk-discount flow (see the bulk-discounts module's applyBulkDiscounts) —
// never required, never a new source of truth
// for pricing/active-window checks. Trilingual name/description + image are
// stored even though nothing reads them yet, because a later phase (a
// newsletter campaign and a hero-slider slide built from an event) will need
// exactly this shape — see product_form_decomposition-style memory notes for
// that phase once it lands.
// Deleting an event never touches the discounts it grouped (FK below is
// SetNull) — the event is metadata about a batch, not the batch's source of
// truth.
model BulkDiscountEvent {
  id              Int                         @id @default(autoincrement())
  nameKa          String
  nameEn          String
  nameRu          String
  descriptionKa   String?
  descriptionEn   String?
  descriptionRu   String?
  imageUrl        String?
  targetType      BulkDiscountEventTargetType
  discountPercent Decimal                     @db.Decimal(5, 2)
  startDate       DateTime
  endDate         DateTime
  // Snapshot of how many items this batch covered at apply time — survives
  // even if every underlying discount row is later individually deleted.
  itemCount       Int
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  productDiscounts ProductVariantDiscount[]
  vehicleDiscounts VehicleListingDiscount[]

  @@schema("dbo")
}
