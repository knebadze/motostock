enum CartItemType {
  PRODUCT_VARIANT
  VEHICLE_LISTING

  @@schema("dbo")
}

// A line in someone's cart — one row per (owner, sellable unit), quantity
// tracked on the row itself rather than duplicating rows for repeat adds.
// ProductVariant (not Product) since a cart line must be a purchase-ready
// size/color pick, unlike WishlistItem which stays at the Product level;
// VehicleListing is already the finest grain on that side, same as wishlist.
//
// Owner is dual-nullable (userId for a logged-in account, guestId for an
// anonymous visitor sharing the same guest-id cookie as wishlist — see
// guest-identity.middleware.ts) — same shape as WishlistItem. Exactly one of
// the two is set per row, enforced both in the service layer AND (since
// migration 20260818093000_add_owner_xor_check_constraints) by a DB-level
// CHECK constraint — Prisma's schema language has no syntax to express that
// here, so it only exists in the migration SQL, not visible in this file.
// No separate "Cart" header row: nothing about a cart beyond its owner and
// its items is ever needed, so a wrapper entity would just be indirection.
model CartItem {
  id               Int             @id @default(autoincrement())
  userId           Int?
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId          String?
  itemType         CartItemType
  productVariantId Int?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  vehicleListingId Int?
  vehicleListing   VehicleListing? @relation(fields: [vehicleListingId], references: [id], onDelete: Cascade)
  quantity         Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, productVariantId])
  @@unique([userId, vehicleListingId])
  @@unique([guestId, productVariantId])
  @@unique([guestId, vehicleListingId])
  @@index([userId])
  @@index([guestId])
  @@schema("dbo")
}
