enum CategoryFilterType {
  PRICE
  BRAND
  ATTRIBUTE

  @@schema("cla")
}

// One ordered filter slot in a category's shop filter sidebar. PRICE/BRAND
// rows are built-in filter types with no extra config beyond "show it, at
// this position"; ATTRIBUTE rows point at a category-scoped Attribute
// (its options/valueType drive the actual filter widget).
model CategoryFilterConfig {
  id          Int                @id @default(autoincrement())
  categoryId  Int
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  filterType  CategoryFilterType
  attributeId Int?
  attribute   Attribute?         @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId])
  @@schema("cla")
}
