enum CategoryFilterType {
  PRICE
  BRAND
  ATTRIBUTE
  MY_VEHICLE

  @@schema("cla")
}

// One ordered filter slot in a category's shop filter sidebar. PRICE/BRAND/
// MY_VEHICLE rows are built-in filter types with no extra config beyond
// "show it, at this position" (MY_VEHICLE renders the logged-in customer's
// own garage as options, filtering products down to ones fitted for the
// chosen vehicle via ProductFitment); ATTRIBUTE rows point at a
// category-scoped Attribute (its options/valueType drive the actual filter
// widget).
model CategoryFilterConfig {
  id          Int                @id @default(autoincrement())
  categoryId  Int
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  filterType  CategoryFilterType
  attributeId Int?
  attribute   Attribute?         @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // At most one ATTRIBUTE-type row per (categoryId, attributeId), and at
  // most one row per (categoryId, filterType) among the built-in types
  // (PRICE/BRAND/MY_VEHICLE) — two different uniqueness keys depending on
  // filterType, which a single @@unique can't express (Prisma's schema DSL
  // has no partial/filtered unique index syntax), so this is migration-SQL-
  // only. See migration 20260914100000_category_filter_config_unique_slots,
  // same per-branch-type pattern as ProductFitmentRule (migration
  // 20260908110000) — closes a check-then-create race in
  // category-filters.service.ts's createCategoryFilter that could otherwise
  // create duplicate filter slots for the same category.
  @@index([categoryId])
  @@schema("cla")
}
