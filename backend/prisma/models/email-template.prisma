// Fixed set of system-triggered transactional emails — one row per
// EmailTemplateKey, bootstrapped lazily on first admin read (see
// email-templates.service.ts, same singleton-per-key pattern as
// HomepageSection) rather than seeded, since every key has a sensible
// default subject/body. Admin can only edit subject/body per language, not
// create/delete — an arbitrary custom key would never actually get
// triggered by anything.
enum EmailTemplateKey {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  // Sent to the admin-configurable notification address (Settings' General
  // tab) right after ORDER_PLACED — see orders.service.ts's placeOrder and
  // settings.service.ts's getAdminNotificationEmail. Skipped entirely while
  // that address is unset.
  NEW_ORDER_ADMIN
  // Sent once a year to every registered customer whose User.dateOfBirth
  // month+day matches today — see birthday-email.service.ts. Never sent to
  // a walk-in (isWalkIn: true) row, since those only ever have a synthetic
  // placeholder address (see user.prisma's isWalkIn comment).
  BIRTHDAY

  @@schema("dbo")
}

model EmailTemplate {
  id        Int              @id @default(autoincrement())
  key       EmailTemplateKey @unique
  subjectKa String
  subjectEn String
  subjectRu String
  bodyKa    String
  bodyEn    String
  bodyRu    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@schema("dbo")
}
