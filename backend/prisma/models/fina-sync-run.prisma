enum FinaSyncTrigger {
  SCHEDULED
  MANUAL
  // A live per-item stock check during checkout (see fina-sync.service.ts's
  // syncVariantStockByIds) that failed to reach FINA — recorded here (unlike
  // a successful checkout-time check, which isn't logged, to avoid a row per
  // shopper visit) so admins can see in the same history as the
  // scheduled/manual jobs that live confirmation is failing, not just that
  // an order landed on PENDING.
  CHECKOUT

  @@schema("dbo")
}

enum FinaSyncStatus {
  // Written up front, before runSync's external FINA call — see
  // fina-sync.service.ts. A run that crashes (process kill, unhandled
  // network hang, etc.) before reaching its own finishRun call is left
  // stuck here with finishedAt still null, which is the visible signal of
  // that crash in the admin's sync history, instead of no row at all.
  RUNNING
  SUCCESS
  FAILED
  PARTIAL

  @@schema("dbo")
}

model FinaSyncRun {
  id              Int             @id @default(autoincrement())
  trigger         FinaSyncTrigger
  status          FinaSyncStatus
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  variantsChecked Int             @default(0)
  variantsUpdated Int             @default(0)
  errorMessage    String?
  triggeredById   Int?
  triggeredBy     User?           @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([triggeredById])
  @@schema("dbo")
}
