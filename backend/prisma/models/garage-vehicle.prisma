// A customer's own vehicle in their "garage" — always points at a
// VehicleCatalog row (either an official one, or one the same flow just
// self-submitted on their behalf). `year` is the specific year of the
// physical vehicle they own, distinct from the catalog row's yearFrom/yearTo
// range (which describes a whole model generation, not one instance).
model GarageVehicle {
  id               Int            @id @default(autoincrement())
  userId           Int
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleCatalogId Int
  vehicleCatalog   VehicleCatalog @relation(fields: [vehicleCatalogId], references: [id])
  year             Int
  // Optional — identifies this one physical vehicle (not stored on
  // VehicleCatalog, which describes a shared model/generation, not an
  // individual unit). Not enforced unique: typos, resales, or a user
  // re-adding the same vehicle shouldn't hard-fail.
  vin              String?
  serviceRecords   ServiceRecord[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([vehicleCatalogId])
  @@schema("dbo")
}
