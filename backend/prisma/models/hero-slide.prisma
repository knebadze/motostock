enum HeroSlideType {
  CTA
  VEHICLE_SEARCH
  // Image + title/subtitle only — no button, no form.
  INFO
  // A category-picker search form, mirrors VEHICLE_SEARCH but resolves to
  // an existing category page (/{category.slug}) instead of a vehicle.
  CATEGORY_FILTER
  // A button whose link is computed automatically (never hand-typed) from
  // discountCategoryId/discountProductBrandId or discountBulkEventId —
  // /shop?onSale=true (narrowed by category/brand when set, general when
  // neither is) unless discountBulkEventId is set, which always wins and
  // links to that event's own scoped listing page instead (see
  // HeroSlider.tsx's buildDiscountLink).
  DISCOUNT

  @@schema("dbo")
}

enum HeroSlideTextPosition {
  LEFT
  CENTER
  RIGHT

  @@schema("dbo")
}

enum HeroSlideVerticalPosition {
  TOP
  MIDDLE
  BOTTOM

  @@schema("dbo")
}

// Admin-configurable homepage hero carousel — a marketing/presentational
// entity. CTA slides use buttonLabel/buttonLink; VEHICLE_SEARCH and
// CATEGORY_FILTER slides render a generic search form instead and leave the
// button fields null; INFO slides render neither; DISCOUNT slides use
// buttonLabel (admin-typed) with an auto-computed link (never buttonLink)
// via the optional discountCategory/discountProductBrand targeting below.
model HeroSlide {
  id                     Int                       @id @default(autoincrement())
  type                   HeroSlideType
  titleKa                String
  titleEn                String
  titleRu                String
  subtitleKa             String?
  subtitleEn             String?
  subtitleRu             String?
  imageUrl               String?
  buttonLabelKa          String?
  buttonLabelEn          String?
  buttonLabelRu          String?
  buttonLink             String?
  // DISCOUNT-only — optional targeting for the auto-computed /shop link.
  // SetNull (not Restrict/Cascade): if the referenced category/brand is
  // later deleted, the slide should just fall back to a general discount
  // link rather than blocking the deletion or vanishing itself.
  discountCategoryId     Int?
  discountCategory       Category?                 @relation(fields: [discountCategoryId], references: [id], onDelete: SetNull)
  discountProductBrandId Int?
  discountProductBrand   ProductBrand?             @relation(fields: [discountProductBrandId], references: [id], onDelete: SetNull)
  // DISCOUNT-only — an alternative to discountCategory/discountProductBrand
  // targeting above: this slide belongs to one BulkDiscountEvent instead
  // (built via that module's own create/edit-slide flow, never through this
  // module's own create/update — see hero-slides.service.ts, which never
  // reads or writes this field). @unique enforces "at most one slide per
  // event" at the DB level, letting that flow use a single upsert keyed on
  // this column. SetNull (not Restrict/Cascade), same reasoning as the
  // category/brand FKs above: deleting the event should fall the slide back
  // to a general discount link, not delete or block deleting the event.
  discountBulkEventId    Int?                      @unique
  discountBulkEvent      BulkDiscountEvent?        @relation(fields: [discountBulkEventId], references: [id], onDelete: SetNull)
  textPosition           HeroSlideTextPosition     @default(LEFT)
  verticalPosition       HeroSlideVerticalPosition @default(BOTTOM)
  isActive               Boolean                   @default(true)
  sortOrder              Int                       @default(0)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([discountCategoryId])
  @@index([discountProductBrandId])
  @@schema("dbo")
}
