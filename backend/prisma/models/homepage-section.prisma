enum HomepageSectionType {
  DISCOUNTED_PRODUCTS
  POPULAR_PRODUCTS
  DISCOUNTED_VEHICLES
  POPULAR_VEHICLES
  DISCOUNTED_MIXED
  POPULAR_MIXED
  CATEGORIES
  // Algorithmic — products compatible with the shopper's SELECTED_VEHICLE_COOKIE
  // pick, ranked by the same order-quantity popularity as POPULAR_PRODUCTS.
  // Resolved per-visitor at read time (unlike every type above, which is
  // identical for everyone), so it renders nothing when no vehicle is
  // selected rather than falling back to a misleadingly-labeled global list.
  POPULAR_FOR_VEHICLE
  // Algorithmic — content-based, per-user: ranks products by category/brand
  // affinity from the shopper's own order + wishlist history, further
  // narrowed to their garage vehicles' compatible set when they have any.
  // Renders nothing for guests or signed-in users with no signal yet.
  RECOMMENDED_FOR_YOU
  // Phase 2 — the shopper's own ProductView history, most-recent first.
  // Works for guests too (shared guest-id cookie), unlike RECOMMENDED_FOR_YOU.
  RECENTLY_VIEWED

  @@schema("dbo")
}

// Admin-configurable homepage sections — a fixed set of exactly one row per
// HomepageSectionType, bootstrapped lazily on first admin read (see
// homepage-sections.service.ts, same singleton-per-key pattern as
// CompanyInfo) rather than seeded, since every field has a sensible default.
// Admin controls title, active/inactive, display order (sortOrder), and how
// many items populate the section — the actual item selection is computed
// at read time (DISCOUNTED_* = active discount, POPULAR_* = ranked by total
// Order quantity, CATEGORIES = top-level Category rows ordered by
// Category.sortOrder), not stored here.
//
// itemCount is used by every type except the two *_MIXED ones, which
// combine products and vehicle listings in a single carousel and so need
// two independent counts instead (productItemCount/vehicleItemCount) —
// both nullable since they're meaningless for the other types.
model HomepageSection {
  id               Int                 @id @default(autoincrement())
  type             HomepageSectionType @unique
  titleKa          String
  titleEn          String
  titleRu          String
  isActive         Boolean             @default(true)
  sortOrder        Int                 @default(0)
  itemCount        Int                 @default(10)
  productItemCount Int?
  vehicleItemCount Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@schema("dbo")
}
