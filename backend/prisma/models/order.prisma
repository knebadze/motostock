enum OrderFulfillmentMethod {
  CARD
  COURIER
  PICKUP

  @@schema("dbo")
}

enum OrderDeliverySpeed {
  STANDARD
  EXPRESS

  @@schema("dbo")
}

// Tracks whether this order's current state (a placed sale, or — once
// cancelled — that sale's return) is actually reflected in FINA, separately
// from whether FINA sync applies to this order at all. See
// fina-sync.service.ts's pushOrderSale/pushOrderReturn/retryOrderFinaPush.
enum FinaOrderSyncStatus {
  // Default — no FINA-linked items on this order, FINA isn't configured, or
  // the FINA web-customer/user Settings aren't filled in yet. Nothing to
  // retry; this is a fact about the order/config, not a failure.
  NOT_APPLICABLE
  // The last push attempt (sale on placement, or return on cancellation)
  // succeeded and FINA reflects this order's current state.
  SYNCED
  // A push was attempted (order has FINA-linked items, FINA is configured)
  // but the FINA API call itself failed — admin can retry via
  // retryOrderFinaPush.
  FAILED

  @@schema("dbo")
}

// A placed order — the historical record of a checkout. Unlike CartItem,
// everything that could later change (address, promo code, product name)
// is snapshotted at creation time (see shippingSnapshot/promoCodeSnapshot/
// OrderItem.itemName below), because an already-placed order must never
// visually change just because a user edited their address or an admin
// renamed a product. No payment provider is integrated (none is installed
// in this codebase yet) — fulfillmentMethod just records how the customer
// said they'd pay/receive; status starts PENDING (see orders.service.ts's
// resolvePendingStatusId) and is confirmed/updated manually.
model Order {
  id        Int    @id @default(autoincrement())
  orderCode String @unique

  // Client-generated once per checkout session and resent unchanged on
  // every retry (double-click, timeout-retry) — see orders.service.ts's
  // placeOrder, which returns the existing order instead of creating a
  // second one when this key is already used. Nullable because it's a
  // recent addition (existing orders predate it) and admin-side code never
  // creates orders directly.
  idempotencyKey String? @unique

  // Restrict, unlike addressId/promoCodeId/bankId below — those are
  // SetNull because an order's own snapshot fields keep it readable without
  // the live row; there's no such snapshot for the buyer or the status
  // itself, so losing either must stay blocked instead of silently
  // orphaning order history.
  userId            Int
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  fulfillmentMethod OrderFulfillmentMethod
  statusId          Int
  status            OrderStatus            @relation(fields: [statusId], references: [id], onDelete: Restrict)

  // SetNull (not Restrict/Cascade): losing the live Address row shouldn't
  // block its deletion or cascade-delete order history — the snapshot below
  // is what the order actually displays.
  addressId        Int?
  address          Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shippingSnapshot Json?

  // null when fulfillmentMethod is PICKUP (no delivery needed). Cost/time
  // are snapshotted from Settings at checkout time (see settings.service.ts's
  // getDeliveryTbilisiPrice/getDeliveryRegionsPrice/getDeliveryExpressPrice)
  // so an already-placed order never changes if the admin later edits
  // delivery pricing — same principle as shippingSnapshot/promoCodeSnapshot.
  deliverySpeed        OrderDeliverySpeed?
  deliveryCost         Decimal             @default(0) @db.Decimal(10, 2)
  deliveryTimeSnapshot String?

  // Same SetNull reasoning as addressId — the code/percent are also
  // snapshotted so the order stays readable even if the PromoCode is later
  // edited or deleted.
  promoCodeId          Int?
  promoCode            PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeSnapshot    String?
  promoDiscountPercent Decimal?   @db.Decimal(5, 2)

  // Only set when fulfillmentMethod=CARD (see orders.service.ts's
  // resolveBank) — which bank the customer said they'd pay through. SetNull
  // (not snapshotted like address/promo code): a bank's identity doesn't
  // drift the way delivery pricing or a promo's discount percent does, so
  // losing the live row on deletion is an acceptable, rare edge case.
  bankId Int?
  bank   Bank? @relation(fields: [bankId], references: [id], onDelete: SetNull)

  // Only set when status.key = CANCELLED (enforced in orders.service.ts's
  // updateOrderStatus, not here). Deliberately default (Restrict) onDelete,
  // unlike bankId's SetNull — this is a plain classifier lookup, and
  // lookups.service.ts's delete guard should block removing a reason that's
  // still referenced by an order, so the analytics reason-breakdown can't
  // silently lose data under it.
  cancellationReasonId Int?
  cancellationReason   CancellationReason? @relation(fields: [cancellationReasonId], references: [id], onDelete: Restrict)
  cancellationNote     String?
  // Set exactly once, atomically, in the same update that flips status to
  // CANCELLED (orders.repository.ts's updateStatus) — analytics.repository.ts's
  // cancellation metrics filter by this, not updatedAt. updatedAt looked like
  // a free "cancelled at" timestamp (nothing else touched it... at the time),
  // but fina-sync.repository.ts's setOrderFinaSyncStatus does its own
  // separate order.update, and @updatedAt bumps on *any* update — so a
  // manual FINA-retry click days after the actual cancellation was silently
  // rewriting what analytics thought was the cancellation date.
  cancelledAt DateTime?

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  // Captured at checkout time (see lib/request-ip.ts's getClientIp) — the
  // one piece of fraud-relevant signal this codebase didn't track before.
  // Used by fraud.service.ts's evaluateOrderRisk to detect promo-code abuse
  // and multi-accounting; never shown to the customer.
  ipAddress String?
  riskFlags OrderRiskFlag[]

  // Set once placeOrder successfully records this order as a sale in FINA
  // (see fina-client.ts's saveDocProductOut) — the returned FINA operation
  // id, needed so a later cancellation can reference it via
  // saveDocCustomerReturn's out_id. Null when FINA isn't configured, the
  // order has no FINA-linked items, or the push itself failed (best-effort,
  // never blocks checkout — see orders.service.ts).
  finaOutOperationId Int?
  finaSyncStatus     FinaOrderSyncStatus @default(NOT_APPLICABLE)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([addressId])
  @@index([promoCodeId])
  @@index([bankId])
  @@index([statusId])
  @@index([cancellationReasonId])
  // Admin order list defaults to orderBy: { createdAt: "desc" } and filters
  // by createdFrom/createdTo (orders.repository.ts), and analytics'
  // revenue-series/order-count-by-status queries filter by a createdAt
  // range (analytics.repository.ts) — none of that was indexed before,
  // meaning a sequential scan + sort as Order grows into the thousands.
  @@index([createdAt])
  // analytics.repository.ts's cancellation metrics (count/lost-revenue/
  // reason-breakdown/recent-list) all range-filter on this.
  @@index([cancelledAt])
  @@schema("dbo")
}
