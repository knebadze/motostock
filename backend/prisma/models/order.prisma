enum OrderFulfillmentMethod {
  CARD
  COURIER
  PICKUP

  @@schema("dbo")
}

enum OrderDeliverySpeed {
  STANDARD
  EXPRESS

  @@schema("dbo")
}

// A placed order — the historical record of a checkout. Unlike CartItem,
// everything that could later change (address, promo code, product name)
// is snapshotted at creation time (see shippingSnapshot/promoCodeSnapshot/
// OrderItem.itemName below), because an already-placed order must never
// visually change just because a user edited their address or an admin
// renamed a product. No payment provider is integrated (none is installed
// in this codebase yet) — fulfillmentMethod just records how the customer
// said they'd pay/receive; status starts PENDING (see orders.service.ts's
// resolvePendingStatusId) and is confirmed/updated manually.
model Order {
  id                Int                    @id @default(autoincrement())
  orderCode         String                 @unique
  userId            Int
  user              User                   @relation(fields: [userId], references: [id])
  fulfillmentMethod OrderFulfillmentMethod
  statusId          Int
  status            OrderStatus            @relation(fields: [statusId], references: [id])

  // SetNull (not Restrict/Cascade): losing the live Address row shouldn't
  // block its deletion or cascade-delete order history — the snapshot below
  // is what the order actually displays.
  addressId        Int?
  address          Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shippingSnapshot Json?

  // null when fulfillmentMethod is PICKUP (no delivery needed). Cost/time
  // are snapshotted from Settings at checkout time (see settings.service.ts's
  // getDeliveryTbilisiPrice/getDeliveryRegionsPrice/getDeliveryExpressPrice)
  // so an already-placed order never changes if the admin later edits
  // delivery pricing — same principle as shippingSnapshot/promoCodeSnapshot.
  deliverySpeed        OrderDeliverySpeed?
  deliveryCost         Decimal             @default(0) @db.Decimal(10, 2)
  deliveryTimeSnapshot String?

  // Same SetNull reasoning as addressId — the code/percent are also
  // snapshotted so the order stays readable even if the PromoCode is later
  // edited or deleted.
  promoCodeId          Int?
  promoCode            PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodeSnapshot    String?
  promoDiscountPercent Decimal?   @db.Decimal(5, 2)

  // Only set when fulfillmentMethod=CARD (see orders.service.ts's
  // resolveBank) — which bank the customer said they'd pay through. SetNull
  // (not snapshotted like address/promo code): a bank's identity doesn't
  // drift the way delivery pricing or a promo's discount percent does, so
  // losing the live row on deletion is an acceptable, rare edge case.
  bankId Int?
  bank   Bank? @relation(fields: [bankId], references: [id], onDelete: SetNull)

  // Only set when status.key = CANCELLED (enforced in orders.service.ts's
  // updateOrderStatus, not here). Deliberately default (Restrict) onDelete,
  // unlike bankId's SetNull — this is a plain classifier lookup, and
  // lookups.service.ts's delete guard should block removing a reason that's
  // still referenced by an order, so the analytics reason-breakdown can't
  // silently lose data under it.
  cancellationReasonId Int?
  cancellationReason   CancellationReason? @relation(fields: [cancellationReasonId], references: [id], onDelete: Restrict)
  cancellationNote     String?

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  // Captured at checkout time (see lib/request-ip.ts's getClientIp) — the
  // one piece of fraud-relevant signal this codebase didn't track before.
  // Used by fraud.service.ts's evaluateOrderRisk to detect promo-code abuse
  // and multi-accounting; never shown to the customer.
  ipAddress String?
  riskFlags OrderRiskFlag[]

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([addressId])
  @@index([promoCodeId])
  @@index([bankId])
  @@index([statusId])
  @@index([cancellationReasonId])
  @@schema("dbo")
}
