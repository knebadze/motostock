model Product {
  id              Int                     @id @default(autoincrement())
  categoryId      Int
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productBrandId  Int?
  // SetNull, not Restrict — this is nullable (optional brand), and Prisma's
  // own implicit default for an optional relation with no onDelete
  // specified is already SetNull in the live schema; written explicitly
  // here to match, not to change it (confirmed against the live DB's FK
  // constraint before writing this — the ProductVariant lookups below are
  // the same situation).
  productBrand    ProductBrand?           @relation(fields: [productBrandId], references: [id], onDelete: SetNull)
  nameKa          String
  nameEn          String
  nameRu          String
  descriptionKa   String?
  descriptionEn   String?
  descriptionRu   String?
  imageUrl        String?
  slug            String                  @unique
  metaTitle       String?
  metaDescription String?
  // Incremented once per product-detail-page view (see
  // products.service.ts's getProductDetail) — a simple popularity/interest
  // signal shown to admins, separate from the Order-based "most sold"
  // ranking used by the homepage "popular products" slider.
  viewCount       Int                     @default(0)
  // Admin-curated (a checkbox on this product's own edit form) — no
  // relation to whether the product is actually new, popular, or on sale;
  // purely "should this be one of the hand-picked items in the homepage's
  // FEATURED_MIXED slider" (see homepage-section.prisma). Deliberately a
  // plain boolean, not a join table — DISCOUNTED_MIXED/POPULAR_MIXED already
  // establish that a homepage mixed-slider's *membership* computation lives
  // entirely in products.service.ts/vehicle-listing.service.ts's query
  // filters, never in HomepageSection itself.
  isFeaturedOnHomepage Boolean            @default(false)
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  fitments        ProductFitment[]
  fitmentRules    ProductFitmentRule[]
  buyTogether     ProductBuyTogether[]    @relation("BuyTogetherAnchor")
  buyTogetherOf   ProductBuyTogether[]    @relation("BuyTogetherRelated")
  wishlistItems   WishlistItem[]
  compareItems    CompareItem[]
  views           ProductView[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([categoryId])
  @@index([productBrandId])
  @@index([isFeaturedOnHomepage])
  // pg_trgm GIN indexes — products.repository.ts's buildWhere searches these
  // three columns with `ILIKE '%term%'` (leading wildcard), which a plain
  // btree index can't accelerate at all; without these, that search does a
  // full table scan and gets slower as the catalog grows. See migration
  // 20260818100000_search_and_popularity_scaling.
  @@index([nameKa(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([nameRu(ops: raw("gin_trgm_ops"))], type: Gin)
  @@schema("dbo")
}
