model Product {
  id              Int                     @id @default(autoincrement())
  categoryId      Int
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productBrandId  Int?
  productBrand    ProductBrand?           @relation(fields: [productBrandId], references: [id])
  nameKa          String
  nameEn          String
  nameRu          String
  descriptionKa   String?
  descriptionEn   String?
  descriptionRu   String?
  imageUrl        String?
  slug            String                  @unique
  metaTitle       String?
  metaDescription String?
  // Incremented once per product-detail-page view (see
  // products.service.ts's getProductDetail) — a simple popularity/interest
  // signal shown to admins, separate from the Order-based "most sold"
  // ranking used by the homepage "popular products" slider.
  viewCount       Int                     @default(0)
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  fitments        ProductFitment[]
  fitmentRules    ProductFitmentRule[]
  buyTogether     ProductBuyTogether[]    @relation("BuyTogetherAnchor")
  buyTogetherOf   ProductBuyTogether[]    @relation("BuyTogetherRelated")
  wishlistItems   WishlistItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([categoryId])
  @@index([productBrandId])
  @@schema("dbo")
}
