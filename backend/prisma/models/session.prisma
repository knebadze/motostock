// One row per issued login (password login/register/reset, OAuth login,
// password change) — its id is embedded in the JWT as sessionId (see
// lib/jwt.ts's JwtPayload) and carried unchanged through every sliding
// idle-timeout renewal (auth.middleware.ts's resolveAuthenticatedUser),
// the same way loginAt already is. Deleting the row (auth.controller.ts's
// logout) is what actually revokes that one token server-side — without
// this, logout only cleared the browser's cookie; the JWT itself stayed
// cryptographically valid and would still authenticate if replayed
// directly (e.g. via curl with an exfiltrated cookie value) until it
// naturally expired. A row surviving past its JWT's own expiry is
// harmless dead weight, not a bug — verifyJwt's own exp check already
// rejects an expired token before resolveAuthenticatedUser ever looks the
// session up, so nothing depends on these being swept.
model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Captured once at login (lib/request-ip.ts) purely for the admin "active
  // sessions" page to tell devices apart — never parsed/trusted for any
  // access-control decision.
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  // Refreshed (throttled, see auth.middleware.ts's resolveAuthenticatedUser)
  // on each authenticated request carrying this session — lets the admin
  // page distinguish a genuinely active session from one that's merely
  // unexpired but abandoned.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  // Backs the admin "active sessions" page's `orderBy: { lastSeenAt: "desc" }`
  // (session.repository.ts's findManyForAdmin) — added in migration
  // 20260908120000 alongside pruneStaleSessions (visitors.service.ts), which
  // bounds this table's growth so the index stays cheap to maintain.
  @@index([lastSeenAt])
  @@schema("dbo")
}
