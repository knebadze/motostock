// Admin-editable "our team" list for the public /about page — same
// image+order+active-toggle shape as HeroSlide, without any of its
// type-branching (no CTA/discount targeting here). Job title comes from
// the Position classifier (see position.prisma) rather than free text, so
// titles stay consistent across members and are managed in one place
// (/admin/general-classifiers).
model TeamMember {
  id         Int      @id @default(autoincrement())
  nameKa     String
  nameEn     String
  nameRu     String
  positionId Int
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  imageUrl   String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  // Service history rows where this member is recorded as the mechanic who
  // performed the work — see ServiceRecord.mechanicId.
  serviceRecordsAsMechanic ServiceRecord[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("dbo")
}
