model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  passwordHash            String?
  googleId                String?                  @unique
  facebookId              String?                  @unique
  firstName               String
  lastName                String
  // Nullable so every pre-existing row and every OAuth signup (which
  // collects neither) are unaffected — required only by registerSchema's
  // email+password path, since it's also the auto-merge key: a walk-in
  // customer created from the workshop (isWalkIn below) with a matching
  // phone gets converted in place into the real account on registration,
  // rather than a separate row being created and reassigned (see
  // auth.service.ts's register).
  phone                   String?                  @unique
  dateOfBirth             DateTime?                @db.Date
  // A customer entered by an admin from the workshop screen (name/phone/DOB
  // only, no login) — a real User row, not a separate table, so the entire
  // existing garage/service-record/admin-user-list machinery just works on
  // them. Flipped false in place the moment a matching registration arrives
  // (see auth.service.ts's register) — the row's id never changes, so
  // garageVehicles/serviceRecords need no reassignment for that path.
  isWalkIn                Boolean                  @default(false)
  // Set by the admin's manual "link to an existing account" fallback
  // (used when the automatic phone-match can't apply — e.g. the customer
  // registered via Google/Facebook, which collects no phone) — the walk-in
  // row itself is kept (not deleted, no delete-user feature exists), its
  // garageVehicles already reassigned onto mergedInto by that point.
  mergedIntoUserId        Int?
  mergedInto              User?                    @relation("UserMerge", fields: [mergedIntoUserId], references: [id], onDelete: SetNull)
  mergedFrom              User[]                   @relation("UserMerge")
  // Null for password-registered accounts until they click the emailed
  // verification link; set immediately at creation for OAuth accounts
  // (Google/Facebook already confirmed the address) — see
  // oauth.service.ts's user-creation call sites and auth.service.ts's
  // verifyEmail. Gates checkout (orders.service.ts) and the whole /account
  // area (frontend's account/layout.tsx redirects to /verify-required when
  // unset) — login itself stays unaffected either way.
  emailVerifiedAt         DateTime?
  // Bumped on every password change (both the emailed reset flow and the
  // authenticated change-password flow — see users.repository.ts's
  // updatePasswordHash) — embedded in every issued JWT (lib/jwt.ts) and
  // compared against this live value on every authenticated request
  // (auth.middleware.ts's resolveAuthenticatedUser); a mismatch means the
  // token predates the account's current password and is rejected, so a
  // password change invalidates every session/device except the one that
  // just performed it (which gets a freshly re-signed cookie in the same
  // response).
  tokenVersion            Int                      @default(0)
  roleId                  Int
  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  finaSyncRuns            FinaSyncRun[]
  scheduledJobRuns        ScheduledJobRun[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  authEvents              AuthEvent[]
  addresses               Address[]
  garageVehicles          GarageVehicle[]
  submittedCatalogEntries VehicleCatalog[]
  wishlistItems           WishlistItem[]
  compareItems            CompareItem[]
  cartItems               CartItem[]
  productViews            ProductView[]
  vehicleListingViews     VehicleListingView[]
  visitorPresence         VisitorPresence?
  visitorVisits           VisitorVisit[]
  orders                  Order[]
  // Service history rows this admin logged in the workshop (not this
  // user's own vehicles' history — see GarageVehicle.serviceRecords for
  // that side).
  recordedServiceRecords  ServiceRecord[]
  whatsappChatSessions    WhatsAppChatSession[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([roleId])
  @@schema("dbo")
}
