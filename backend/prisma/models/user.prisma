model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  passwordHash            String?
  googleId                String?                  @unique
  facebookId              String?                  @unique
  firstName               String
  lastName                String
  // Null for password-registered accounts until they click the emailed
  // verification link; set immediately at creation for OAuth accounts
  // (Google/Facebook already confirmed the address) — see
  // oauth.service.ts's user-creation call sites and auth.service.ts's
  // verifyEmail. Gates checkout (orders.service.ts) and the whole /account
  // area (frontend's account/layout.tsx redirects to /verify-required when
  // unset) — login itself stays unaffected either way.
  emailVerifiedAt         DateTime?
  // Bumped on every password change (both the emailed reset flow and the
  // authenticated change-password flow — see users.repository.ts's
  // updatePasswordHash) — embedded in every issued JWT (lib/jwt.ts) and
  // compared against this live value on every authenticated request
  // (auth.middleware.ts's resolveAuthenticatedUser); a mismatch means the
  // token predates the account's current password and is rejected, so a
  // password change invalidates every session/device except the one that
  // just performed it (which gets a freshly re-signed cookie in the same
  // response).
  tokenVersion            Int                      @default(0)
  roleId                  Int
  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  finaSyncRuns            FinaSyncRun[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  authEvents              AuthEvent[]
  addresses               Address[]
  garageVehicles          GarageVehicle[]
  submittedCatalogEntries VehicleCatalog[]
  wishlistItems           WishlistItem[]
  compareItems            CompareItem[]
  cartItems               CartItem[]
  productViews            ProductView[]
  vehicleListingViews     VehicleListingView[]
  orders                  Order[]
  // Service history rows this admin logged in the workshop (not this
  // user's own vehicles' history — see GarageVehicle.serviceRecords for
  // that side).
  recordedServiceRecords  ServiceRecord[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([roleId])
  @@schema("dbo")
}
