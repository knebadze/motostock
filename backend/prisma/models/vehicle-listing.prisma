model VehicleListing {
  id               Int                      @id @default(autoincrement())
  vehicleCatalogId Int
  vehicleCatalog   VehicleCatalog           @relation(fields: [vehicleCatalogId], references: [id])
  conditionId      Int
  condition        Condition                @relation(fields: [conditionId], references: [id])
  statusId         Int
  status           ListingStatus            @relation(fields: [statusId], references: [id])
  colorId          Int
  color            Color                    @relation(fields: [colorId], references: [id])
  year             Int
  isActive         Boolean                  @default(true)
  price            Decimal                  @db.Decimal(10, 2)
  stockQuantity    Int                      @default(1)
  descriptionKa    String?
  descriptionEn    String?
  descriptionRu    String?
  // Single global counter, bumped on every detail-page view — see
  // vehicle-listing.service.ts's getVehicleListing. Distinct from
  // VehicleListingView below, which is per-visitor (see that model's
  // comment for why both exist — same split as Product.viewCount/ProductView).
  viewCount        Int                      @default(0)
  images           VehicleListingImage[]
  discounts        VehicleListingDiscount[]
  wishlistItems    WishlistItem[]
  compareItems     CompareItem[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  views            VehicleListingView[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([vehicleCatalogId])
  @@index([conditionId])
  @@index([statusId])
  @@index([colorId])
  @@schema("dbo")
}
