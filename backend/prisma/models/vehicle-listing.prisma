model VehicleListing {
  id               Int                      @id @default(autoincrement())
  vehicleCatalogId Int
  vehicleCatalog   VehicleCatalog           @relation(fields: [vehicleCatalogId], references: [id])
  conditionId      Int
  condition        Condition                @relation(fields: [conditionId], references: [id])
  statusId         Int
  status           ListingStatus            @relation(fields: [statusId], references: [id])
  colorId          Int
  color            Color                    @relation(fields: [colorId], references: [id])
  year             Int
  isActive         Boolean                  @default(true)
  price            Decimal                  @db.Decimal(10, 2)
  stockQuantity    Int                      @default(1)
  descriptionKa    String?
  descriptionEn    String?
  descriptionRu    String?
  images           VehicleListingImage[]
  discounts        VehicleListingDiscount[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([vehicleCatalogId])
  @@index([conditionId])
  @@index([statusId])
  @@index([colorId])
  @@schema("dbo")
}
