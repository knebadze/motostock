{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:admin": "playwright test tests/admin --workers=1",
    "test:customer": "playwright test tests/customer/ --workers=1",
    "test:deletion": "playwright test tests/deletion/ --workers=1",
    "test:full": "npm run test:admin && npm run test:customer && npm run test:deletion"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
